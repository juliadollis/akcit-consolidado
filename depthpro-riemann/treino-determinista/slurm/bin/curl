#!/usr/bin/env python3
"""
Shim de `curl` para o nosso .sif (que nao tem curl nem wget instalados).

Motivo: scripts/download_hypersim_stream.py:85 faz
    os.system('curl -fL -s "<url>" --output "<zip>"')
e, sem o binario curl, `os.system` devolve rc!=0. A funcao do Francisco trata
rc!=0 como "cena inexistente" e PULA a cena em silencio, entao o download
terminava com zero imagens e sem erro fatal.

Este shim implementa, com urllib, o subconjunto de flags que o codigo dele usa,
mantendo a MESMA semantica de saida:
    -f / --fail        -> exit!=0 em HTTP >= 400 (sem deixar arquivo parcial)
    -L / --location    -> segue redirect (urllib ja faz por padrao)
    -s / --silent      -> sem progresso
    -o / --output PATH -> grava no arquivo

Instalado em slurm/bin/ e colocado no inicio do PATH pelos .slurm.
Nao altera nenhuma linha do codigo do Francisco.
"""

import shutil
import sys
import urllib.error
import urllib.request
from pathlib import Path

TIMEOUT = 120
UA = "curl/8.0 (shim urllib)"


def main(argv):
    url = None
    out = None
    fail_on_error = False

    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-o", "--output"):
            i += 1
            out = argv[i] if i < len(argv) else None
        elif a.startswith("-") and len(a) > 1 and not a.startswith("--"):
            # flags curtas agrupadas, ex.: -fL, -fsSL
            if "f" in a[1:]:
                fail_on_error = True
            # -L, -s, -S sao no-op aqui
        elif a in ("--fail",):
            fail_on_error = True
        elif a in ("--location", "--silent", "--show-error", "--compressed"):
            pass
        elif not a.startswith("-"):
            url = a
        i += 1

    if not url:
        print("curl-shim: nenhuma URL informada", file=sys.stderr)
        return 2

    req = urllib.request.Request(url, headers={"User-Agent": UA})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
            if fail_on_error and getattr(resp, "status", 200) >= 400:
                return 22
            if out:
                dst = Path(out)
                dst.parent.mkdir(parents=True, exist_ok=True)
                tmp = dst.with_suffix(dst.suffix + ".part")
                with open(tmp, "wb") as fh:
                    shutil.copyfileobj(resp, fh, length=1024 * 1024)
                tmp.replace(dst)
            else:
                shutil.copyfileobj(resp, sys.stdout.buffer, length=1024 * 1024)
    except urllib.error.HTTPError as e:
        # -f: nao deixa arquivo parcial e sinaliza erro (curl usa 22)
        print(f"curl-shim: HTTP {e.code} em {url}", file=sys.stderr)
        return 22 if fail_on_error else 0
    except Exception as e:  # rede, DNS, timeout, TLS
        print(f"curl-shim: {type(e).__name__}: {e}", file=sys.stderr)
        return 7

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
