#!/usr/bin/env python3
"""
Shim de `wget` para o nosso .sif (que nao tem wget instalado).

Motivo: scripts/download_weights.py:39 faz
    subprocess.run(["wget", "-q", "--show-progress", URL, "-O", dest])
e sem o binario isso estoura FileNotFoundError. Havia um fallback
(slurm/dl_weights.py), mas ele so entrava depois de um traceback confuso no log.

Implementa o subconjunto usado: -O/--output-document PATH, ignorando -q,
--show-progress e afins. Nao altera o codigo do Francisco.
"""

import shutil
import sys
import urllib.error
import urllib.request
from pathlib import Path

TIMEOUT = 300
UA = "Wget/1.21 (shim urllib)"


def main(argv):
    url = None
    out = None

    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-O", "--output-document"):
            i += 1
            out = argv[i] if i < len(argv) else None
        elif a.startswith("-"):
            pass  # -q, --show-progress, -c, ... : no-op
        else:
            url = a
        i += 1

    if not url:
        print("wget-shim: nenhuma URL informada", file=sys.stderr)
        return 2

    req = urllib.request.Request(url, headers={"User-Agent": UA})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
            if out and out != "-":
                dst = Path(out)
                dst.parent.mkdir(parents=True, exist_ok=True)
                tmp = dst.with_suffix(dst.suffix + ".part")
                with open(tmp, "wb") as fh:
                    shutil.copyfileobj(resp, fh, length=1024 * 1024)
                tmp.replace(dst)
                print(f"wget-shim: salvo em {dst} ({dst.stat().st_size} bytes)")
            else:
                shutil.copyfileobj(resp, sys.stdout.buffer, length=1024 * 1024)
    except urllib.error.HTTPError as e:
        print(f"wget-shim: HTTP {e.code} em {url}", file=sys.stderr)
        return 8
    except Exception as e:
        print(f"wget-shim: {type(e).__name__}: {e}", file=sys.stderr)
        return 4

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
