# Copie para `.env` (git-ignored) e preencha:
#     cp .env.example .env && ${EDITOR:-nano} .env
#
# Todos os scripts de scripts/*.slurm e scripts/*.sh carregam este arquivo
# automaticamente. A ordem de precedencia e:
#     variavel ja exportada no ambiente  >  $ENV_FILE  >  .env na raiz
#
# No cluster, mantenha o .env com permissao restrita:
#     chmod 600 .env

# Token do Hugging Face. Necessario para os datasets akcit-pixel/* (privados)
# e para black-forest-labs/FLUX.1-dev (gated).
# Gere em: https://huggingface.co/settings/tokens
HF_TOKEN=

# API key do Weights & Biases, para o logging de treino.
# Gere em: https://wandb.ai/authorize
WANDB_API_KEY=
